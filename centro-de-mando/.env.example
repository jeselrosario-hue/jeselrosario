# Copia este archivo a .env y llénalo. El .env NUNCA se sube a GitHub.
PORT=3000
# Carpeta del Cerebro (el repo clonado). En tu PC: la ruta donde lo tienes.
CEREBRO_DIR=/ruta/al/Cerebro
# 1 = el servidor hace `git pull` del Cerebro cada 5 minutos (para el VPS)
CEREBRO_GIT=0
# Contraseña de entrada. Genera el valor con: npm run hash
DASH_PASSWORD_HASH=
# Cadena larga al azar (por ejemplo: openssl rand -hex 32)
SESSION_SECRET=
# 1 cuando se sirve por HTTPS (en el VPS). Con http local déjalo en 0.
COOKIE_SECURE=0
# Conexiones (se llenan en las versiones siguientes; vacías = "pendiente")
NETLIFY_TOKEN=
NETLIFY_SITE_ID=
GMAIL_CLIENT_ID=
# Hermes (solo lectura). En el VPS: http://host.docker.internal:32769
HERMES_URL=
HERMES_USER=
HERMES_PASS=
