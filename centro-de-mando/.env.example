# Copia este archivo a .env y llénalo. El .env NUNCA se sube a GitHub.
PORT=3000
# Carpeta donde el Centro de mando guarda su propio estado (estados de solicitudes, aprobaciones)
DATA_DIR=./datos
# Carpeta del Cerebro (el repo clonado). En tu PC: la ruta donde lo tienes.
CEREBRO_DIR=/ruta/al/Cerebro
# 1 = el servidor hace `git pull` del Cerebro cada 5 minutos (para el VPS)
CEREBRO_GIT=0
# Contraseña de entrada. Genera el valor con: npm run hash
DASH_PASSWORD_HASH=
# Cadena larga al azar (por ejemplo: openssl rand -hex 32)
SESSION_SECRET=
# 1 cuando se sirve por HTTPS (en el VPS). Con http local déjalo en 0.
COOKIE_SECURE=0
# Conexiones (se llenan en las versiones siguientes; vacías = "pendiente")
NETLIFY_TOKEN=
NETLIFY_SITE_ID=
# Nombre corto del equipo de Netlify (app.netlify.com/teams/ESTE). Sirve para leer los créditos.
NETLIFY_TEAM=
# Aviso en Hoy cuando queden menos créditos que esto
NETLIFY_CREDITOS_MINIMO=60
# Cal.com (solo lectura de reservas). Settings → Developer → API keys
CAL_API_KEY=
GMAIL_CLIENT_ID=
# Hermes (solo lectura). En el VPS: http://host.docker.internal:32769
HERMES_URL=
HERMES_USER=
HERMES_PASS=
# Chat con Hermes (su API Server). Lo llena: bash vps-instalar.sh hermes-chat
HERMES_API_URL=
HERMES_API_KEY=
